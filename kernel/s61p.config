# Config fragment merged on top of arm64 defconfig. Everything needed to reach a shell over USB is built in (no modules in initramfs).
CONFIG_LOCALVERSION="-s61p"
CONFIG_ARCH_ROCKCHIP=y
CONFIG_I2C_RK3X=y
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_PINCTRL_PX30=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_PX30=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_CONFIGFS_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_REGULATOR_TPS65185=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_EFI=n
# Rockchip cpufreq/dvfs can hang early boot on unverified rails; disable until PMIC verified.
CONFIG_ARM_ROCKCHIP_CPUFREQ=n
CONFIG_ARM_SCMI_CPUFREQ=n
