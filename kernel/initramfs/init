#!/bin/sh
# Milestone-1 init: prove Linux booted by exposing a USB gadget (serial + ethernet) named "S61P-Linux".
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/busybox mount -t configfs none /sys/kernel/config 2>/dev/null
echo "S61P-LINUX: init started" > /dev/kmsg
G=/sys/kernel/config/usb_gadget/s61p
mkdir -p $G && cd $G
echo 0x1d6b > idVendor; echo 0x0104 > idProduct
mkdir -p strings/0x409
echo "S61P-Linux" > strings/0x409/product
echo "atakhadiviom" > strings/0x409/manufacturer
echo "s61p0001" > strings/0x409/serialnumber
mkdir -p configs/c.1 functions/acm.usb0 functions/ecm.usb0
echo 00:11:22:33:44:55 > functions/ecm.usb0/host_addr
echo 00:11:22:33:44:56 > functions/ecm.usb0/dev_addr
ln -s functions/acm.usb0 configs/c.1/
ln -s functions/ecm.usb0 configs/c.1/
UDC=$(ls /sys/class/udc | head -n1)
echo "S61P-LINUX: UDC=$UDC" > /dev/kmsg
echo "$UDC" > UDC
ip addr add 192.168.7.2/24 dev usb0 2>/dev/null; ip link set usb0 up 2>/dev/null
# serial shell on the gadget ACM port
while true; do
  if [ -c /dev/ttyGS0 ]; then /bin/sh < /dev/ttyGS0 > /dev/ttyGS0 2>&1; fi
  sleep 1
done
